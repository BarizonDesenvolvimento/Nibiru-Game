  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Poco_Boca
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: e1
    speaker: Elena
    text: "(O po\xE7o abre no ch\xE3o como uma boca: andaimes de ferro, um guincho
      parado, um holofote da Funda\xE7\xE3o apontado para baixo. Do fundo sobe um
      ar frio e, de vez em quando, um raspar de pedra contra pedra.)"
    next: e2
    raise: {fileID: 0}
    choices: []
  - id: e2
    speaker: Elena
    text: "Tem alguma coisa l\xE1 embaixo. E n\xE3o \xE9 gente."
    next: e3
    raise: {fileID: 0}
    choices: []
  - id: e3
    speaker: Elena
    text: "O Samir disse que a passagem sai da antec\xE2mara. N\xE3o existe outro
      caminho."
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 0}
