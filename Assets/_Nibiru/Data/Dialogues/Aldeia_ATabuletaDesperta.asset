  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Aldeia_ATabuletaDesperta
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: e1
    speaker: Elena
    text: "(Ela pousa a tabuleta no nicho, ao lado da lamparina. Sob os dedos dela,
      as linhas de ouro acendem uma a uma, e a pedra se enche de uma luz azul que
      n\xE3o \xE9 deste mundo.)"
    next: s1
    raise: {fileID: 0}
    choices: []
  - id: s1
    speaker: Samir
    text: "(Ele d\xE1 um passo para tr\xE1s. A chama da lamparina encolhe.) Doutora...
      n\xE3o."
    next: v1
    raise: {fileID: 0}
    choices: []
  - id: v1
    speaker: Voz
    text: "Tila. Voc\xEA est\xE1 viva, e est\xE1 segura. N\xE3o tenha medo."
    next: v2
    raise: {fileID: 0}
    choices: []
  - id: v2
    speaker: Voz
    text: Agora, olhe.
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 0}
