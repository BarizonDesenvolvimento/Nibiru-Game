MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Acampamento_RadioKast
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: k1
    speaker: "Kast (r\xE1dio)"
    text: "Acampamento de Ur, aqui \xE9 o Dr. Aurelian Kast, da Funda\xE7\xE3o Enlil.
      Doutora Varga, est\xE1 me ouvindo? C\xE2mbio."
    next: e1
    raise: {fileID: 0}
    choices: []
  - id: e1
    speaker: Elena
    text: "Estou ouvindo. Aqui \xE9 Elena Varga. A minha equipe... est\xE3o todos
      mortos."
    next: k2
    raise: {fileID: 0}
    choices: []
  - id: k2
    speaker: "Kast (r\xE1dio)"
    text: "Gra\xE7as a Deus a senhora est\xE1 bem. Sinto muito pela sua equipe. Sinto
      de verdade."
    next: k3
    raise: {fileID: 0}
    choices: []
  - id: k3
    speaker: "Kast (r\xE1dio)"
    text: "Uma equipe de resgate j\xE1 est\xE1 a caminho. Vinte minutos. Fique onde
      est\xE1 e n\xE3o toque em nada, por favor."
    next: k4
    raise: {fileID: 0}
    choices: []
  - id: k4
    speaker: "Kast (r\xE1dio)"
    text: "Sua m\xE3e tamb\xE9m tinha esse talento: estar no lugar errado na hora
      certa. Aguente firme, doutora."
    next: 
    raise: {fileID: 0}
    choices:
    - text: Estou esperando.
      next: confia
      requires: {fileID: 0}
      raise: {fileID: 11400000, guid: 790bdcd712edfe84890b82cd25a10981, type: 2}
      reputation: []
    - text: "Como voc\xEAs sabem que eu estou viva?"
      next: desconfia
      requires: {fileID: 0}
      raise: {fileID: 11400000, guid: 05cab8b4eec9cb1488d7d0507573592c, type: 2}
      reputation: []
  - id: confia
    speaker: "Kast (r\xE1dio)"
    text: "\xD3timo. Vinte minutos, doutora. C\xE2mbio, desligo."
    next: e2
    raise: {fileID: 0}
    choices: []
  - id: desconfia
    speaker: "Kast (r\xE1dio)"
    text: "...N\xE3o sab\xEDamos, doutora. Torc\xEDamos. Monitoramos a frequ\xEAncia
      da expedi\xE7\xE3o desde a invas\xE3o, e o seu nome estava na lista. Vinte
      minutos. C\xE2mbio, desligo."
    next: e2
    raise: {fileID: 0}
    choices: []
  - id: e2
    speaker: Elena
    text: "Ele conhecia a minha m\xE3e?"
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 11400000, guid: a927ba5fc1fa8944eb2c49ca36fe12aa, type: 2}
