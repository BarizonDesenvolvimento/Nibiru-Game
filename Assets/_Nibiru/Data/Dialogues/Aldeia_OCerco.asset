%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Aldeia_OCerco
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: s1
    speaker: Samir
    text: "Fecharam a estrada do norte. A do rio tamb\xE9m: ouvi os caminh\xF5es
      de madrugada. E olhe o helic\xF3ptero descendo na base."
    next: e1
    raise: {fileID: 0}
    choices: []
  - id: e1
    speaker: Elena
    text: "Ent\xE3o estamos presos."
    next: s2
    raise: {fileID: 0}
    choices: []
  - id: s2
    speaker: Samir
    text: "A aldeia est\xE1. N\xF3s, n\xE3o. Existe um caminho mais velho que qualquer
      estrada. Come\xE7a l\xE1 embaixo, no Po\xE7o, e sai no leito seco do wadi,
      longe do cerco. Minha caminhonete est\xE1 l\xE1."
    next: e2
    raise: {fileID: 0}
    choices: []
  - id: e2
    speaker: Elena
    text: "No Po\xE7o? Onde a minha equipe morreu?"
    next: s3
    raise: {fileID: 0}
    choices: []
  - id: s3
    speaker: Samir
    text: "Na antec\xE2mara tem uma parede com o barco de junco, igual ao do nicho.
      A passagem fica atr\xE1s dela."
    next: s4
    raise: {fileID: 0}
    choices: []
  - id: s4
    speaker: Samir
    text: "Mas para chegar ao Po\xE7o, voc\xEA vai ter que atravessar a base deles,
      no p\xE9 do zigurate."
    next: 
    raise: {fileID: 0}
    choices:
    - text: "Voc\xEA n\xE3o vem comigo?"
      next: s5
      requires: {fileID: 0}
      raise: {fileID: 0}
      reputation: []
    - text: "Os Guardi\xF5es sempre souberam desse caminho?"
      next: g1
      requires: {fileID: 11400000, guid: 7d730eba18fe2714aa3b15c5b0b13f2a, type: 2}
      raise: {fileID: 0}
      reputation: []
  - id: g1
    speaker: Samir
    text: "N\xF3s cavamos esse caminho, doutora. H\xE1 muito tempo. Para sair l\xE1
      de baixo... ou para levar alguma coisa de volta."
    next: s5
    raise: {fileID: 0}
    choices: []
  - id: s5
    speaker: Samir
    text: "Sozinho, eu passo pelos canais secos do sul at\xE9 o wadi. Com voc\xEA
      e essa pedra acendendo a cada passo, n\xE3o. Eu espero voc\xEA na caminhonete."
    next: s6
    raise: {fileID: 0}
    choices: []
  - id: s6
    speaker: Samir
    text: "A tenda m\xE9dica tamb\xE9m fica na base. Se ainda quer salvar o Yusuf,
      o rem\xE9dio est\xE1 l\xE1."
    next: s7
    raise: {fileID: 0}
    choices: []
  - id: s7
    speaker: Samir
    text: A patrulha anda rente ao muro. Espere os dois virarem de costas e contorne
      a ponta sul do muro.
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 11400000, guid: bec6fe93055c4fd428aac4a4b05bd61a, type: 2}
