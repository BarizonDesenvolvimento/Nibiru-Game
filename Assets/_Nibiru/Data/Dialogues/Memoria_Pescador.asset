  nodes:
  - id: p1
    speaker: Pescador
    text: "O rio subiu dois palmos desde a \xFAltima lua, Ziusudra. E nem choveu
      l\xE1 no norte."
    next: p2
    raise: {fileID: 0}
    choices: []
  - id: p2
    speaker: Pescador
    text: "Os velhos dizem que \xE9 sinal. Que os deuses est\xE3o cansados de n\xF3s."
