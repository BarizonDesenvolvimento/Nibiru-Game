  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Aldeia_AMarca
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: e1
    speaker: Elena
    text: "(Ela pisca. A casa, a lamparina, o Samir. Passou s\xF3 um minuto. No pulso
      esquerdo, uma marca azul, fina como tinta debaixo da pele. N\xE3o sai quando
      ela esfrega.)"
    next: v1
    raise: {fileID: 0}
    choices: []
  - id: v1
    speaker: Voz
    text: "N\xE3o tenha medo da marca. Ela s\xF3 quer dizer que eu estou com voc\xEA."
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 0}
