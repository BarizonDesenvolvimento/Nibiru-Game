    choices: []
  - id: s2
    speaker: Soldado
    text: Comando, Equipe Dois. Achei a doutora, na beira da aldeia. Viva.
    next: e1
    raise: {fileID: 0}
    choices: []
  - id: e1
    speaker: Elena
    text: "Eu vi o que voc\xEAs fizeram com o Hassan."
    next: s3
    raise: {fileID: 0}
    choices: []
  - id: s3
    speaker: Soldado
    text: "Ningu\xE9m perguntou, doutora. De joelhos. Devagar."
