  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Passagem_Inscricao
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: e1
    speaker: Elena
    text: "(Sob o barco de junco, uma faixa de escrita em ouro corre pela pedra.
      Ela l\xEA em voz alta, devagar, e as palavras saem sem esfor\xE7o.)"
    next: e2
    raise: {fileID: 0}
    choices: []
  - id: e2
    speaker: Elena
    text: "\u201CQuem vem da \xE1gua e traz o barco, passe. Quem vem para ferir,
      volte. N\xF3s guardamos o caminho para quem precisa sair.\u201D"
    next: e3
    raise: {fileID: 0}
    choices: []
  - id: e3
    speaker: Elena
    text: "(A tabuleta pulsa na bolsa, quente como uma m\xE3o. A pedra \xE0 frente
      dela responde.)"
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 11400000, guid: 7b9f4baef5356f4429a3b29084563e77, type: 2}
