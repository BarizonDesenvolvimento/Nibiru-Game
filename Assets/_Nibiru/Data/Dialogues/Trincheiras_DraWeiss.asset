  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Trincheiras_DraWeiss
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: w1
    speaker: Mulher ferida
    text: "N\xE3o! N\xE3o atire... Por favor. Eu sou m\xE9dica. Hannah Weiss."
    next: e1
    raise: {fileID: 0}
    choices: []
  - id: e1
    speaker: Elena
    text: "Esse uniforme... Voc\xEA \xE9 da Funda\xE7\xE3o."
    next: w2
    raise: {fileID: 0}
    choices: []
  - id: w2
    speaker: Dra. Weiss
    text: "Eu me perdi da equipe quando o helic\xF3ptero desceu. Ca\xED numa dessas
      valas e abri a perna. Ningu\xE9m voltou para me buscar."
    next: w3
    raise: {fileID: 0}
    choices: []
  - id: w3
    speaker: Dra. Weiss
    text: "Voc\xEA \xE9 a doutora Varga, n\xE3o \xE9? Est\xE3o procurando voc\xEA.
      Vieram para te tirar daqui."
    next: 
    raise: {fileID: 0}
    choices:
    - text: Eles executaram um trabalhador ferido.
      next: contou
      requires: {fileID: 0}
      raise: {fileID: 0}
      reputation: []
    - text: Me tirar daqui. Sei.
      next: calou
      requires: {fileID: 0}
      raise: {fileID: 0}
      reputation: []
  - id: contou
    speaker: Dra. Weiss
    text: "N\xE3o. N\xE3o pode ser. Eu estava no briefing, o Dr. Kast disse \"resgate\".
      Ele disse resgate..."
    next: w4
    raise: {fileID: 0}
    choices: []
  - id: calou
    speaker: Dra. Weiss
    text: "Voc\xEA n\xE3o confia em mim. No seu lugar, eu tamb\xE9m n\xE3o confiaria."
    next: w4
    raise: {fileID: 0}
    choices: []
  - id: w4
    speaker: Dra. Weiss
    text: "Escuta: assim eu n\xE3o consigo andar. Se voc\xEA achar curativos, volte
      aqui. Tenho antibi\xF3ticos na mochila, posso retribuir."
    next: e2
    raise: {fileID: 0}
    choices: []
  - id: e2
    speaker: Elena
    text: Fique abaixada. Se eu achar, eu volto.
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 11400000, guid: 8bf2125114ba72f40920d52628a35eab, type: 2}
