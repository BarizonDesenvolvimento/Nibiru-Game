%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e6f515f2d78f90c478b69593785f8897, type: 3}
  m_Name: Wadi_RadioKast
  m_EditorClassIdentifier: Assembly-CSharp::Nibiru.Dialogue.DialogueDefinition
  nodes:
  - id: k1
    speaker: "Kast (r\xE1dio)"
    text: "Doutora Varga. Sabia que a senhora atravessaria. Sua m\xE3e tamb\xE9m
      atravessava."
    next: k2
    raise: {fileID: 0}
    choices: []
  - id: k2
    speaker: "Kast (r\xE1dio)"
    text: "Os moradores da Aldeia est\xE3o cercados. Todos: o rapaz doente, a senhora
      idosa, quem mais estiver nas casas. Meus homens esperam uma palavra minha."
    next: k3
    raise: {fileID: 0}
    choices: []
  - id: k3
    speaker: "Kast (r\xE1dio)"
    text: "Deixe a tabuleta no ch\xE3o do wadi, onde est\xE1, e siga seu caminho.
      Meus homens a buscam, soltam todos e saem da Aldeia. Ningu\xE9m mais se machuca."
    next: s1
    raise: {fileID: 0}
    choices: []
  - id: s1
    speaker: "Samir (r\xE1dio)"
    text: "Doutora, n\xE3o ou\xE7a. A tabuleta tem de voltar para o Po\xE7o, enterrada
      no nicho. Se ele a levar, n\xE3o sobra ningu\xE9m para impedi-lo."
    next: v1
    raise: {fileID: 0}
    choices: []
  - id: v1
    speaker: Voz
    text: "(baixinho, s\xF3 para ela) N\xE3o abra m\xE3o de nada."
    next: escolha
    raise: {fileID: 0}
    choices: []
  - id: escolha
    speaker: Elena
    text: "(O r\xE1dio chia. A tabuleta est\xE1 morna na bolsa. O que fazer com ela?)"
    next: 
    raise: {fileID: 0}
    choices:
    - text: "Deixar a tabuleta no ch\xE3o para o Kast."
      next: entrega
      requires: {fileID: 0}
      raise: {fileID: 11400000, guid: ddc282898265b5749bf08d79cd2654bc, type: 2}
      reputation:
      - faction: {fileID: 11400000, guid: e0c386dc13728be4087ce05e9b6861f6, type: 2}
        amount: 15
      - faction: {fileID: 11400000, guid: 47c93f3fb05c9af4cb50cf23ccaf9716, type: 2}
        amount: -15
    - text: "Levar a tabuleta de volta ao Po\xE7o, com o Samir."
      next: devolve
      requires: {fileID: 0}
      raise: {fileID: 11400000, guid: 826bcad97c4419741bca61768932e3f5, type: 2}
      reputation:
      - faction: {fileID: 11400000, guid: 47c93f3fb05c9af4cb50cf23ccaf9716, type: 2}
        amount: 15
      - faction: {fileID: 11400000, guid: e0c386dc13728be4087ce05e9b6861f6, type: 2}
        amount: -15
    - text: "Ficar com a tabuleta e n\xE3o dizer nada."
      next: fica
      requires: {fileID: 0}
      raise: {fileID: 11400000, guid: b28a546c5c60c3643840a730d79839f0, type: 2}
      reputation:
      - faction: {fileID: 11400000, guid: e0c386dc13728be4087ce05e9b6861f6, type: 2}
        amount: -5
      - faction: {fileID: 11400000, guid: 47c93f3fb05c9af4cb50cf23ccaf9716, type: 2}
        amount: -5
  - id: entrega
    speaker: "Kast (r\xE1dio)"
    text: Sensata, doutora. Meus homens a buscam. Os soldados deixam a Aldeia ao
      amanhecer.
    next: entrega2
    raise: {fileID: 0}
    choices: []
  - id: entrega2
    speaker: "Samir (r\xE1dio)"
    text: "Voc\xEA deu uma chave para eles, doutora. Uma chave."
    next: fim
    raise: {fileID: 0}
    choices: []
  - id: devolve
    speaker: "Kast (r\xE1dio)"
    text: "Lament\xE1vel."
    next: devolve2
    raise: {fileID: 0}
    choices: []
  - id: devolve2
    speaker: "Samir (r\xE1dio)"
    text: Venha. Eu espero na caminhonete.
    next: fim
    raise: {fileID: 0}
    choices: []
  - id: fica
    speaker: Voz
    text: "S\xE1bia."
    next: fim
    raise: {fileID: 0}
    choices: []
  - id: fim
    speaker: Elena
    text: "(Ela desliga o r\xE1dio. O vento cobre o chiado.)"
    next: 
    raise: {fileID: 0}
    choices: []
  raiseOnEnd: {fileID: 11400000, guid: a0955fa8a6431084bb6f49216cb22589, type: 2}
